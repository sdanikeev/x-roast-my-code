PORT=4000
FRONTEND_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app
REDIS_HOST=localhost
REDIS_PORT=6379

# generate with: openssl rand -base64 48 (use two different values, min 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# https://github.com/settings/developers -> OAuth Apps; callback must equal GITHUB_CALLBACK_URL
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# Secure cookie flag. Unset = on in production only. Use true behind https.
COOKIE_SECURE=false
# Trust X-Forwarded-For (for the login throttle) ONLY behind a reverse proxy that overwrites it, e.g. TRUST_PROXY=1.
# Unset = req.ip is the socket address (safe default; a client-supplied header can't pick its own IP).
TRUST_PROXY=


GROQ_API_KEY=

# ---- LLM for /roast: any OpenAI-compatible API ----
# Set ONE key and the provider is detected; or pick explicitly with LLM_PROVIDER=groq|openai|openrouter|ollama|custom
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b        # groq default; e.g. gpt-4o-mini (openai), qwen/qwen3.8-27b (groq)
# LLM_ROASTER_MODEL=openai/gpt-oss-20b  # optional: different model for the roasting pass = separate rate-limit bucket
# Best bug-finding on the free Groq tier: analyst=qwen (finds logic bugs), roaster=gpt-oss (separate rate bucket):
#   LLM_MODEL=qwen/qwen3.8-27b   LLM_ROASTER_MODEL=openai/gpt-oss-120b
# Free qwen allows only ~1000 output tokens/min => ~1 roast per minute (429 otherwise). A paid tier removes this.
# LLM_ANALYST_EFFORT=high              # reasoning effort for bug hunting (low|medium|high); costs more tokens
# LLM_JSON_MODE=json_schema            # or json_object for models without structured outputs
# LLM_REASONING_EFFORT=low             # optional: speeds up reasoning models
# LLM_TIMEOUT_MS=120000
# local ollama:  LLM_PROVIDER=ollama  OLLAMA_URL=http://localhost:11434  LLM_MODEL=qwen2.5-coder:7b
# anything else: LLM_PROVIDER=custom  LLM_BASE_URL=https://.../v1  LLM_MODEL=...  LLM_API_KEY=...
ROAST_RATE_PER_MINUTE=10
ROAST_MAX_CONCURRENT=4
